<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.hamdy.motionkit" ExtensionBundleVersion="1.10.3" ExtensionBundleName="Hamdy Motion Kit" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.hamdy.motionkit.panel" Version="1.10.3"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[16.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.hamdy.motionkit.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--autoplay-policy=no-user-gesture-required</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Hamdy Motion Kit</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>860</Width></Size>
            <MinSize><Height>380</Height><Width>360</Width></MinSize>
            <MaxSize><Height>3000</Height><Width>4000</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/brand/icon_normal.png</Icon>
            <Icon Type="RollOver">./assets/brand/icon_rollover.png</Icon>
            <Icon Type="DarkNormal">./assets/brand/icon_dark.png</Icon>
            <Icon Type="DarkRollOver">./assets/brand/icon_dark_rollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
